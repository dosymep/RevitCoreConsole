<Project Sdk="Autodesk.Revit.Sdk.Refs/2.0.0">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <Configurations>D2018;D2019;D2020;D2021;D2022;D2023;D2024;D2025;Debug;Release;D2026;D2026.5;D2027</Configurations>
        <Platforms>x64</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\RevitEngine.DBApplications\RevitEngine.DBApplications.csproj" />
        <ProjectReference Include="..\RevitEngine\RevitEngine.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RevitEngine.UnitTests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Serilog"/>
        <PackageReference Include="Serilog.Sinks.File"/>
        <PackageReference Include="Serilog.Sinks.Console"/>
        <PackageReference Include="Serilog.Extensions.Hosting"/>

        <PackageReference Include="Spectre.Console"/>

        <PackageReference Include="System.CommandLine"/>
        <PackageReference Include="Microsoft.Extensions.Options"/>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
    </ItemGroup>

    <ItemGroup Condition="'$(RevitVersion)' != ''">
        <None Remove="appsettings*.json"/>
        <None Include="appsettings.$(RevitVersion).json">
            <Link>appsettings.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Creates appsettings.{RevitVersion}.json from the default template if it is missing. -->
    <Target Name="EnsureVersionedAppSettings"
            BeforeTargets="PrepareForBuild"
            Condition="'$(RevitVersion)' != ''">
        <PropertyGroup>
            <_AppSettingsDefault>$(MSBuildProjectDirectory)\appsettings.json</_AppSettingsDefault>
            <_AppSettingsVersioned>$(MSBuildProjectDirectory)\appsettings.$(RevitVersion).json</_AppSettingsVersioned>
        </PropertyGroup>
        <Copy SourceFiles="$(_AppSettingsDefault)"
              DestinationFiles="$(_AppSettingsVersioned)"
              Condition="Exists('$(_AppSettingsDefault)') AND !Exists('$(_AppSettingsVersioned)')"
              SkipUnchangedFiles="true"/>
    </Target>
</Project>
