<Project Sdk="Autodesk.Revit.Sdk.Refs/2.0.0">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <Configurations>D2018;D2019;D2020;D2021;D2022;D2023;D2024;D2025;Debug;Release;D2026;D2026.5;D2027</Configurations>
        <Platforms>x64</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\RevitEngine.DBApplications\RevitEngine.DBApplications.csproj" />
        <ProjectReference Include="..\RevitEngine\RevitEngine.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="RevitEngine.UnitTests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Serilog"/>
        <PackageReference Include="Serilog.Sinks.File"/>
        <PackageReference Include="Serilog.Sinks.Console"/>
        <PackageReference Include="Serilog.Extensions.Hosting"/>

        <PackageReference Include="Spectre.Console"/>

        <PackageReference Include="System.CommandLine"/>
        <PackageReference Include="Microsoft.Extensions.Options"/>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="appsettings*.json"/>
        <None Include="appsettings.$(RevitVersion).json">
            <Link>appsettings.json</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.2018.json"/>
        <None Update="appsettings.2019.json"/>
        <None Update="appsettings.2020.json"/>
        <None Update="appsettings.2021.json"/>
        <None Update="appsettings.2022.json"/>
        <None Update="appsettings.2023.json"/>
        <None Update="appsettings.2024.json"/>
        <None Update="appsettings.2025.json"/>
        <None Update="appsettings.2026.json"/>
        <None Update="appsettings.2027.json"/>
    </ItemGroup>
</Project>
