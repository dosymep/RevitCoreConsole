<?xml version="1.0" encoding="utf-8"?>
<RevitAddIns>
    <AddIn Type="DBApplication">
        <Name>Sample.CsvExport</Name>
        <Assembly>.\Sample.CsvExport.dll</Assembly>
        <AddInId>5F0AC719-5463-422F-864F-FE055A965140</AddInId>
